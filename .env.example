# .env.example
# 应用环境配置示例文件
# 复制此文件为 .env，并按需修改

# 环境设置 (development, test, production)
DENO_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=password
DB_NAME=testdb
DB_PORT=3306
DB_POOL_SIZE=5

# 服务器配置
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# 安全配置
APP_SECRET=your-secret-key-here
JWT_EXPIRES=1d

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json 