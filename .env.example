# .env.example
# 应用环境配置示例文件
# 复制此文件为 .env，并按需修改

# 环境设置 (development, test, production)
DENO_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=password
DB_NAME=testdb
DB_PORT=3306
DB_POOL_SIZE=5

# 服务器配置
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# 安全配置
APP_SECRET=your-secret-key-here
JWT_EXPIRES=1d

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# Deno应用环境变量示例
# 复制此文件为.env并修改相应的值

# 应用环境设置
NODE_ENV=development  # development 或 production

# 服务器设置
HOST=0.0.0.0

# API设置
API_BASE_URL=http://localhost:8000/api  # 本地开发
# API_BASE_URL=https://elpis-deno-elpis.deno.dev/api  # 生产环境

# 安全设置
JWT_SECRET=your-secret-key-here  # JWT令牌密钥

# CORS设置
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # 允许的跨域源，逗号分隔

# 数据库设置 - MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net  # MongoDB连接URI
MONGODB_USER=username  # MongoDB用户名
MONGODB_PASSWORD=password  # MongoDB密码
MONGODB_DATABASE=elpis-beta  # MongoDB数据库名

# 日志设置
LOG_LEVEL=debug  # debug, info, warn, error

# 微信设置
WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret

# Deno Deploy设置（仅用于Deno Deploy环境）
# DENO_DEPLOYMENT_ID - 由Deno Deploy自动设置 